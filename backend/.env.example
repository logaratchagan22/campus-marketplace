# Copy this file to .env and fill in real values. Never commit .env to Git.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://your_user:password_@cluster0.ace3ur3.mongodb.net

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=your_key

# JWT expiry
JWT_EXPIRES_IN=7d

# Port the API listens on
PORT=5000

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
